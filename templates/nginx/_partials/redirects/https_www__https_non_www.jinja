# SSL www, redirect to SSL without www.
server {
  server_name www.{{ domain }};
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;

  access_log ofd;
  {% include '_partials/error_log.ninja' %}
  {% include '_partials/ssl.ninja' %}
  {% include '_partials/acme_challenge.ninja' %}

  location / {
    return 301 https://$server_name$request_uri;
  }
}