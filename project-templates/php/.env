# All of these will be read from docker and can be used in containers.

# Global settings
PROJECT_NAME=
PROJECT_ENV=dev
PROJECT_DOMAIN="${PROJECT_NAME}.local"
PROJECT_USE_DOCKER=1
PROJECT_CONTAINER_NAME="${PROJECT_NAME}"
PROJECT_CONTAINER_UID=1000
PROJECT_CONTAINER_PORT=9000
PROJECT_PATH_IN_CONTAINER=/srv/app
PROJECT_PATH_IN_PROXY_CONTAINER="/srv/${PROJECT_NAME}"
PROJECT_PROXY_PROJECT_NAME=proxy
PROJECT_DOCKER_NETWORK_NAME=proxy_bridge

# Specify,which config templates to build when executing
# project run update_nginx_templates
PROJECT_NGINX_TEMPLATE=proxy:nginx/drupal_docker_basic
