# Do not edit this file manually. It is autogenerated.
services:
  app:
    container_name: {{ container_name }}
    build:
      context: ./app
      args:
        - CONTAINER_UID={{ container_uid }}
        - APP_ENV={{ environment }}
    volumes:
      - ../../:{{ project_path_in_container|default('/srv/app') }}
    restart: always
    user: www-data
    extra_hosts:
      - host.docker.internal:host-gateway
    networks:
      - {{ network_name }}

networks:
  {{ network_name }}:
    name: {{ network_name }}
    external: true
