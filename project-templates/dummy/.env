# Global settings
PROJECT_NAME=dummy
PROJECT_ENV=dev
PROJECT_USE_DOCKER=0
PROJECT_DOMAIN="${PROJECT_NAME}.local"
PROJECT_URL="http://${PROJECT_DOMAIN}"
PROJECT_PATH_IN_PROXY_CONTAINER="/srv/${PROJECT_DOMAIN}"

PROJECT_DOCKER_NETWORK_NAME=proxy_bridge

PROJECT_PROXY_PROJECT_NAME=proxy
# The path to the template to use for creating an nginx config.
PROJECT_NGINX_TEMPLATE="${PROJECT_PROXY_PROJECT_NAME}:nginx/static_basic"
